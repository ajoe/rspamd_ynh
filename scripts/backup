#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers

#=================================================
# BACKUP VARIOUS FILES
#=================================================

ynh_backup "/usr/share/yunohost/hooks/conf_regen/99-postfix_rspamd"
# Backup custom rspamd configuration (aggressive spam filtering, blocklists, custom Lua rules)
ynh_backup "/etc/rspamd/local.d/redis.conf"
ynh_backup "/etc/rspamd/local.d/classifier-bayes.conf"
ynh_backup "/etc/rspamd/local.d/dkim_signing.conf"
ynh_backup "/etc/rspamd/local.d/actions.conf"
ynh_backup "/etc/rspamd/local.d/dmarc.conf"
ynh_backup "/etc/rspamd/local.d/groups.conf"
ynh_backup "/etc/rspamd/local.d/multimap.conf"
ynh_backup "/etc/rspamd/local.d/rbl.conf"
ynh_backup "/etc/rspamd/local.d/maps.d"
ynh_backup "/etc/rspamd/lua.local.d/custom_spam_rules.lua"

# Backup dovecot sieve scripts (imapsieve-based learning)
ynh_backup "/etc/dovecot/yunohost.d/post-ext.d/antispam.conf"
ynh_backup "/usr/lib/dovecot/sieve/report-spam.sieve"
ynh_backup "/usr/lib/dovecot/sieve/report-ham.sieve"
ynh_backup "/usr/lib/dovecot/sieve/rspamd-learn-spam.sh"
ynh_backup "/usr/lib/dovecot/sieve/rspamd-learn-ham.sh"

#=================================================
# END OF SCRIPT
#=================================================

ynh_print_info "Backup script completed for $app. (YunoHost will then actually copy those files to the archive)."
